# El módulo de Incidencias usa EspoCRM (entidad CIncidencia) por defecto:
#   http://local.grupoeldeber.com/api/v1
# Si algún día EspoCRM cambia de URL, descomenta y ajusta:
# VITE_INCIDENTS_API_URL=http://local.grupoeldeber.com/api/v1

# --- API key compartida (services/espoClient.ts) ---------------------------
# La usan Órdenes de Compra, Solicitudes, Proformas, Sugerencias e Incidencias
# (un solo lugar en vez de repetida en cada archivo). Inventario tiene su
# propia copia por separado a propósito (ver cabecera de inventoryService.ts).
# VITE_ESPOCRM_API_KEY=2b4fd11376a17549cba81c63a8840727

# --- Órdenes de Compra (services/purchaseOrderService.ts) ------------------
# En EspoCRM la entidad quedó creada como "CCOrdenCompra" (con doble C, por
# como se escribió en Entity Manager) en vez de "COrdenCompra".
# VITE_PURCHASE_ORDERS_API_URL=http://local.grupoeldeber.com/api/v1
VITE_PURCHASE_ORDER_ENTITY=CCOrdenCompra
# VITE_PURCHASE_ORDER_LINES_SUBRESOURCE=lineas
# VITE_PURCHASE_ORDER_TAX_RATE=13

# --- Solicitudes de Compra (services/purchaseRequestService.ts) ------------
# Igual que arriba: quedó como "CCSolicitudCompra" en EspoCRM.
# VITE_PURCHASE_REQUESTS_API_URL=http://local.grupoeldeber.com/api/v1
VITE_PURCHASE_REQUEST_ENTITY=CCSolicitudCompra
# VITE_PURCHASE_REQUEST_LINES_SUBRESOURCE=detalle
# VITE_PURCHASE_REQUEST_HISTORY_SUBRESOURCE=historial

# --- Proformas (services/proformaService.ts) -------------------------------
# Igual que arriba: quedó como "CCProforma" en EspoCRM.
# VITE_PROFORMAS_API_URL=http://local.grupoeldeber.com/api/v1
VITE_PROFORMA_ENTITY=CCProforma
# VITE_PROFORMAS_SUBRESOURCE=proformas
# VITE_PROFORMA_LINES_SUBRESOURCE=lineas
# VITE_PROFORMA_TAX_RATE=13
# Días antes del vencimiento en que una proforma se marca "próxima a vencer":
# VITE_PROFORMA_EXPIRY_WARNING_DAYS=3

# --- Sugerencias por área/cargo (services/suggestionService.ts) ------------
# Igual que arriba: quedó como "CCSugerenciaProducto" en EspoCRM.
# VITE_SUGGESTIONS_API_URL=http://local.grupoeldeber.com/api/v1
VITE_SUGGESTION_ENTITY=CCSugerenciaProducto

# --- Servidor de fotos (services/photoServer.ts) ----------------------------
# Servidor aparte de EspoCRM, solo para fotos de equipos y el logo de
# impresión. Antes esta IP vivía repetida como literal en 6 archivos.
# VITE_PHOTOS_BASE_URL=http://172.20.16.38
